          <mxGeometry x="0" y="72" width="360" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="EmailSendLog" value="&lt;&lt;model&gt;&gt;  &lt;b&gt;EmailSendLog&lt;/b&gt;  &lt;font color=&quot;#667085&quot;&gt;[servermanager_emailsendlog]&lt;/font&gt;" style="swimlane;whiteSpace=wrap;html=1;startSize=72;fillColor=#E8F3EC;strokeColor=#3C7758;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#1F2937;align=left;spacingLeft=10;verticalAlign=middle;container=1;collapsible=0;recursiveResize=0;" parent="1" vertex="1">
          <mxGeometry x="1370" y="720" width="360" height="212" as="geometry"/>
        </mxCell>
        <mxCell id="EmailSendLog_fields" value="+ id : BigAutoField {PK}&lt;br/&gt;+ emailto : Char(300)&lt;br/&gt;+ title : Char(2000)&lt;br/&gt;+ content : Text&lt;br/&gt;+ send_result : Boolean" style="text;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;strokeColor=none;fillColor=none;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#263445;" parent="EmailSendLog" vertex="1">
          <mxGeometry x="0" y="72" width="360" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="analysis_note" value="模型分析结论&lt;br/&gt;1. BlogUser 与 Article、Comment 为一对多；Article 通过自动中间表与 Tag 构成多对多。&lt;br/&gt;2. Category 使用父分类自关联表达层级，Comment 使用父评论自关联表达回复关系，父节点均允许为空。&lt;br/&gt;3. AbstractUser 和 BaseModel 是抽象基类，只提供公共字段，不单独生成数据库表。&lt;br/&gt;4. Links、SideBar、BlogSettings、OAuthConfig、commands、EmailSendLog 主要承担展示、配置和运维职责，彼此没有显式外键。&lt;br/&gt;5. CommentReaction 使用 (comment, user, reaction_type) 组合唯一约束，防止同一用户重复提交同一反应。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#B8C2CC;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=16;spacingTop=12;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#263445;" parent="1" vertex="1">
          <mxGeometry x="60" y="1220" width="1670" height="140" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
